---
import Base from '../layouts/Base.astro';
import PostListPage from '../components/PostListPage.astro';
import { allPosts, PER_PAGE } from '../lib/posts';

const posts = await allPosts();
const totalPages = Math.ceil(posts.length / PER_PAGE);
---

<Base>
  <p class="home-intro">
    실무에서 <strong>얻어맞은 자리</strong>를 글로 되갚는 곳.
  </p>
  <PostListPage posts={posts.slice(0, PER_PAGE)} page={1} totalPages={totalPages} />
</Base>

---
import Base from '../layouts/Base.astro';
import {
  allPosts,
  formatDate,
  postPath,
  categoriesOf,
  excerptOf,
  readingMinutes,
  readingLabel,
  readingTip,
} from '../lib/posts';

const posts = await allPosts();
const INITIAL = 10; // 나머지는 스크롤하며 search.json 에서 이어붙인다
const initial = posts.slice(0, INITIAL);
---

<Base>
  <ul class="post-list" id="post-list">
    {
      initial.map((post) => (
        <li>
          <div class="title-row">
            <a class="title" href={postPath(post)}>
              {post.data.title}
            </a>
            <span class="reading tip" data-tip={readingTip(post)}>{readingLabel(post)}</span>
          </div>
          <p class="excerpt">{excerptOf(post, 150)}</p>
          <div class="meta">
            <span class="chip">{categoriesOf(post).at(-1)}</span>
            <span class="views" data-views-path={postPath(post)} hidden />
            <span class="comments-metric" data-comments-path={postPath(post)} hidden />
            <time>{formatDate(post)}</time>
          </div>
        </li>
      ))
    }
  </ul>

  <div id="scroll-sentinel" aria-hidden="true"></div>
  <p id="list-end" class="list-end muted" hidden>마지막 글까지 다 봤어요.</p>

  <script is:inline define:vars={{ initialCount: INITIAL, total: posts.length }}>
    (() => {
      const list = document.getElementById('post-list');
      const sentinel = document.getElementById('scroll-sentinel');
      const endMsg = document.getElementById('list-end');
      let offset = initialCount;
      const STEP = 10;
      let all = null;
      let loading = false;

      if (offset >= total) {
        sentinel.remove();
        endMsg.hidden = false;
        return;
      }

      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function append(items) {
        const html = items
          .map((p) => {
            const cat = (p.categories && p.categories.length)
              ? p.categories[p.categories.length - 1]
              : '';
            return (
              '<li>' +
              '<div class="title-row">' +
              '<a class="title" href="' + p.url + '">' + esc(p.title) + '</a>' +
              '<span class="reading tip" data-tip="이 게시글을 읽는 데 ' + (p.minutes || 1) +
                '분 정도 걸릴 것 같아요!">' + (p.minutes || 1) + '분 분량</span>' +
              '</div>' +
              '<p class="excerpt">' + esc(p.excerpt || '') + '</p>' +
              '<div class="meta">' +
              (cat ? '<span class="chip">' + esc(cat) + '</span>' : '') +
              '<span class="views" data-views-path="' + p.url + '" hidden></span>' +
              '<time>' + esc(p.date.replace(/-/g, '.')) + '</time>' +
              '</div></li>'
            );
          })
          .join('');
        list.insertAdjacentHTML('beforeend', html);
        // 새로 붙은 항목에도 조회수를 채운다
        if (window.fillViews) window.fillViews(list);
      }

      function loadMore() {
        if (loading || offset >= total) return;
        loading = true;

        const ready = all
          ? Promise.resolve(all)
          : fetch('/search.json').then((r) => { return r.json(); });

        ready
          .then((json) => {
            all = json;
            append(all.slice(offset, offset + STEP));
            offset += STEP;
            loading = false;
            if (offset >= total) {
              io.disconnect();
              sentinel.remove();
              endMsg.hidden = false;
              return;
            }
            // IntersectionObserver 는 "교차 상태가 바뀔 때"만 부르므로,
            // 한 번 더 붙여도 sentinel 이 계속 보이는 화면(긴 뷰포트)에서는 멈춰버린다.
            // 아직 트리거 영역 안이면 직접 이어서 부른다.
            requestAnimationFrame(() => {
              const r = sentinel.getBoundingClientRect();
              if (r.top < window.innerHeight + 500) loadMore();
            });
          })
          .catch(() => {
            // 실패하면 무한 스크롤만 포기하고, 기존 페이지 목록으로 안내
            loading = false;
            io.disconnect();
            sentinel.remove();
            endMsg.textContent = '목록을 더 불러오지 못했어요.';
            endMsg.hidden = false;
          });
      }

      // 화면 아래 500px 전에 미리 불러온다
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) loadMore();
        },
        { rootMargin: '500px 0px' }
      );
      io.observe(sentinel);
    })();
  </script>
</Base>

<style is:global>
  #scroll-sentinel { height: 1px; }
  .list-end {
    margin: 3rem 0 0;
    text-align: center;
    font-size: 0.85rem;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { allPosts, formatDate, postPath, postDateParts } from '../lib/posts';

const posts = await allPosts();
const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const { y } = postDateParts(post);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
---

<Base title="Archives" description="연도별로 정리한 전체 글 목록.">
  <h1 class="page-title">Archives</h1>
  {
    years.map(([year, list]) => (
      <section>
        <h2 class="group-title" id={year}>{year} <span class="muted">({list.length})</span></h2>
        <ul class="archive-list">
          {list.map((post) => (
            <li>
              <time>{formatDate(post)}</time>
              <a href={postPath(post)}>{post.data.title}</a>
              <span class="views" data-views-path={postPath(post)} hidden />
              <span class="comments-metric" data-comments-path={postPath(post)} hidden />
              <span class="likes-metric" data-likes-path={postPath(post)} hidden />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

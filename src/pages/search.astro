---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/posts';
---

<Base title="Search">
  <h1 class="page-title">Search</h1>
  <input id="search-input" type="search" placeholder="제목·태그·본문으로 검색…" autofocus />

  <!-- 검색 전: 많이 본 글 상위 10 (조회수 API가 없으면 최근 글로 폴백) -->
  <section id="default-section">
    <h2 class="group-title" id="default-title">최근 글</h2>
    <ul class="archive-list" id="default-list"></ul>
  </section>

  <!-- 검색 결과 -->
  <section id="result-section" hidden>
    <h2 class="group-title" id="result-title"></h2>
    <ul class="archive-list" id="result-list"></ul>
  </section>

  <!-- 결과 없음 -->
  <section id="empty-section" hidden>
    <p class="search-empty" id="empty-message"></p>
    <h2 class="group-title">이런 글은 어때요</h2>
    <ul class="archive-list" id="empty-list"></ul>
  </section>

  <script is:inline define:vars={{ chatOrigin: 'https://kimmand0o0-blog-chat.kimmand0o0.workers.dev' }}>
    (() => {
      const input = document.getElementById('search-input');
      const defaultSection = document.getElementById('default-section');
      const defaultTitle = document.getElementById('default-title');
      const defaultList = document.getElementById('default-list');
      const resultSection = document.getElementById('result-section');
      const resultTitle = document.getElementById('result-title');
      const resultList = document.getElementById('result-list');
      const emptySection = document.getElementById('empty-section');
      const emptyMessage = document.getElementById('empty-message');
      const emptyList = document.getElementById('empty-list');
      let posts = [];

      function row(p) {
        return (
          '<li><time>' + p.date + '</time><a href="' + p.url + '">' +
          p.title.replace(/</g, '&lt;') + '</a>' +
          '<span class="views" data-views-path="' + p.url + '" hidden></span></li>'
        );
      }

      function render(el, list) {
        el.innerHTML = list.map(row).join('');
        if (window.fillViews) window.fillViews(el);
      }

      function search(q) {
        const needle = q.toLowerCase();
        return posts.filter((p) => {
          return (
            p.title.toLowerCase().includes(needle) ||
            (p.tags || []).some((t) => { return t.toLowerCase().includes(needle); }) ||
            (p.categories || []).some((c) => { return c.toLowerCase().includes(needle); }) ||
            (p.excerpt || '').toLowerCase().includes(needle)
          );
        });
      }

      function onInput() {
        const q = input.value.trim();
        if (!q) {
          defaultSection.hidden = false;
          resultSection.hidden = true;
          emptySection.hidden = true;
          return;
        }
        defaultSection.hidden = true;
        const hits = search(q);
        if (hits.length) {
          resultSection.hidden = false;
          emptySection.hidden = true;
          resultTitle.textContent = '검색 결과 (' + hits.length + ')';
          render(resultList, hits.slice(0, 50));
        } else {
          resultSection.hidden = true;
          emptySection.hidden = false;
          emptyMessage.textContent = '“' + q + '”에 해당하는 글이 없어요.';
          // 추천 5개는 기본 목록(많이 본 글 또는 최근 글)에서 가져온다
          render(emptyList, (window.__defaultPosts || posts).slice(0, 5));
        }
      }

      fetch('/search.json')
        .then((r) => { return r.json(); })
        .then((json) => {
          posts = json;
          // 기본값은 최근 글 — 조회수 데이터가 도착하면 그때 교체한다
          window.__defaultPosts = posts.slice(0, 10);
          render(defaultList, window.__defaultPosts);
          input.addEventListener('input', onInput);

          // 조회수 상위 — 워커가 아직 배포 전이거나 데이터가 비면 조용히 최근 글 유지
          return fetch(chatOrigin + '/api/views/top?limit=10')
            .then((r) => { return r.ok ? r.json() : null; })
            .then((top) => {
              if (!top || !top.items || !top.items.length) return;
              const byUrl = {};
              posts.forEach((p) => { byUrl[p.url] = p; });
              const ranked = top.items
                .map((i) => { return byUrl[i.path]; })
                .filter(Boolean);
              if (!ranked.length) return;
              window.__defaultPosts = ranked;
              defaultTitle.textContent = '많이 본 글';
              if (!input.value.trim()) render(defaultList, ranked);
            })
            .catch(() => { /* 조회수는 부가 정보 — 실패해도 검색은 그대로 */ });
        });
    })();
  </script>
</Base>

<style is:global>
  .search-empty {
    margin: 2rem 0 0;
    font-size: 0.98rem;
    color: var(--muted);
  }
</style>

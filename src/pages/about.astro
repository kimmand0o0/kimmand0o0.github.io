---
import Base from '../layouts/Base.astro';

// 포스트와 같은 목차 레일 — 손으로 쓴 페이지라 앵커를 직접 선언한다
const toc = [
  { depth: 2, slug: 'introduce', text: 'Introduce' },
  { depth: 2, slug: 'skills', text: 'Skills' },
  { depth: 2, slug: 'work-experience', text: 'Work Experience' },
  { depth: 3, slug: 'bunkerkids', text: '벙커키즈 주식회사' },
  { depth: 3, slug: 'jakga', text: '작가 주식회사' },
  { depth: 2, slug: 'project', text: 'Project' },
  { depth: 3, slug: 'lol-moim', text: '롤모임' },
];
---

<Base
  title="About"
  description="풀스택 개발자 Haeran 의 이력과 프로젝트 — 벙커키즈 Whif, 롤모임 등."
  width="wide"
>
  <div class="post-layout">
  <div class="prose about">
    <h2 id="introduce">Introduce</h2>
    <hr />
    <h3>Product Developer</h3>
    <p>
      기능을 만들고, 그게 <strong>정말 효과가 있었는지 데이터로 확인하는 일</strong>을 합니다.
      확인해보면 기대와 다를 때가 많아서, 그 과정을 이 블로그에 기록합니다.
    </p>
    <p>
      회사에서는 결제·정산·글로벌화를, 퇴근 후에는 친구들과 쓰는 서비스를 기획부터 운영까지 직접 만들고 있습니다.
    </p>

    <h4>CONNECT</h4>
    <ul>
      <li><strong>Mail:</strong> maeran.dev.u@gmail.com</li>
      <li><strong>Github:</strong> <a href="https://github.com/kimmand0o0">https://github.com/kimmand0o0</a></li>
    </ul>

    <h2 id="skills">Skills</h2>
    <hr />
    <div class="skills-grid">
      <div>
        <p>JavaScript</p>
        <p>TypeScript</p>
        <p>React 19</p>
        <p>Next.js</p>
      </div>
      <div>
        <p>Zustand</p>
        <p>TanStack Query</p>
        <p>Tailwind-css</p>
        <p>Styled-Components</p>
      </div>
      <div>
        <p>Python(FastAPI)</p>
        <p>Go(Connect-RPC)</p>
        <p>PostgreSQL</p>
        <p>Protocol Buffers</p>
      </div>
      <div>
        <p>Vite</p>
        <p>Capacitor</p>
        <p>Electron.js</p>
        <p>CSS-modules</p>
      </div>
    </div>

    <h2 id="work-experience">Work Experience</h2>
    <hr />
    <h3 id="bunkerkids"><a href="https://www.whif.io/">벙커키즈 주식회사</a></h3>
    <p>
      <strong>Product Developer</strong> (2025. 07 ~ 현재)
      <br />
      <span class="muted">React 19, TypeScript, Vite, Zustand, TanStack Query, Capacitor, Python(FastAPI), Go(Connect-RPC), Protocol Buffers, PostgreSQL</span>
    </p>

    <p>
      <span>AI 캐릭터 채팅 서비스 <a href="https://www.whif.io/"><strong>Whif</strong></a>에서 Frontend(React 19)를 중심으로 Backend(FastAPI)·Gateway(Go BFF)를 넘나드는 풀스택 개발자로 근무하며, 결제·정산·글로벌화 등 서비스 핵심 도메인을 설계·구현하고 있습니다.</span>
    </p>

    <ul>
      <li>
        신규 유저 대상 첫결제 유도 배너 배포 후 전환 데이터를 추적해 5주간 미노출되던 버그를 발견·수정
        <br />
        <span class="stat-highlight">결제 전환율 0.81% → 8.03%(약 10배), 주문 8.8배 증가</span> (동일 규모 16만 명 코호트 비교)
      </li>
      <li>
        비로그인 체험 대화 → 가입 → 결제로 이어지는 전환 퍼널을 이벤트 추적 체계와 함께 설계
        <br />
        <span class="stat-highlight">가입 전환 유저의 30.8%가 결제로 이어지는 구조 확인</span>(서비스 평균 대비 약 1.6배)
      </li>
      <li>
        커플룸/정실 등록 리텐션 기능 출시 후 데이터로 효과 검증
        <br />
        <span class="stat-highlight">활동 유저 비율 +10.4%p, 1인당 활동일수 약 2배 증가</span>
      </li>
      <li>
        위프(재화) 차감 로직을 선차감 → 후차감 방식으로 통일, 차감 정책 명문화
        <br />
        <span class="stat-highlight">dead code 약 850줄 제거</span>
      </li>
      <li>재화 자동충전 결제 기능을 백엔드 전 계층으로 구현, 이후 멱등성을 강화해 중복 충전 방지</li>
      <li>
        정실 유저 약 1만 명의 리텐션 적립이 <span class="stat-highlight">19시간 전면 실패</span>한 장애를 원인 분석·긴급 수정·데이터 백필로 대응
        <br />
        재발 방지 규칙을 팀 전역 문서화
      </li>
      <li>커플룸 등록 기능(<span class="stat-highlight">123커밋 규모</span>)을 LLM 기반 상황 대사 생성 포함해 도메인 전체 설계·구현</li>
      <li>앱 내 본인인증(Capacitor), 쿠키 동의 배너(CCPA/LGPD) 등 <span class="stat-highlight">9개국</span> 서비스의 글로벌 규제 대응 구현</li>
      <li>Claude Code 기반 AI 페어 프로그래밍 워크플로우(커스텀 스킬/서브에이전트 자동화)를 팀 개발 표준으로 도입·정착</li>
    </ul>

    <h3 id="jakga">작가 주식회사</h3>
    <p>
      <strong>Product Developer</strong> (2024. 02 ~ 2024. 12)
      <br />
      <span class="muted">React, TypeScript, Electron.js, Zustand, Million.js, Supabase, Tailwind-css</span>
    </p>

    <p>
      <span>Electron.js를 활용해 <strong>Task 관리에 최적화된 생산성 브라우저 데스크탑 앱</strong>을 개발했습니다.</span>
      <br />
      <span>
        사용자는 To-Do List로 할 일을 정리하고, Rich Text Editor를 통해 노트를 작성하며, 브라우저 기능을 프로스페이스 앱에서 Task 기능과 함께 활용해 효율적인 작업을 도와주는 서비스 입니다.
      </span>
    </p>

    <ul>
      <li>million.js를 활용한 퍼포먼스 개선으로 같은 조건에서 시작한 랜더링의 완료 속도가 65% 가량 감소 <a href="https://github.com/kimmand0o0/kimmand0o0.github.io/wiki/million.js%EB%A5%BC-%ED%86%B5%ED%95%9C-%EB%8D%B0%EC%8A%A4%ED%81%AC%ED%83%91-%EB%B8%8C%EB%9D%BC%EC%9A%B0%EC%A0%80-%EC%95%B1-%EC%B5%9C%EC%A0%81%ED%99%94">(Wiki)</a></li>
      <li>tiptap-editor를 이용하여 리치 텍스트 에디터 구현 및 키보드 단축키 연결</li>
      <li>Dnd-kit을 활용하여 space, tab-group, tab 사이의 드래그 앤 드랍 구현</li>
      <li>Web-Worker를 통해 각 스페이스(공간)별 시간 기록</li>
      <li>color-picker를 이용해 확장성 높은 색상 팔레트 구현 및 cwag기준에 맞는 텍스트 컬러 변경</li>
    </ul>

    <h2 id="project">Project</h2>
    <hr />
    <h3 id="lol-moim"><a href="https://lol-mo-im.vercel.app/?home=1">롤모임 — 리그 오브 레전드 사설 내전 커뮤니티 플랫폼</a></h3>
    <p>
      <a href="/tags.html#운영일지"><strong>개발 일지</strong></a>
      (2026. 05 ~ 운영 중)
      <br />
      <span class="muted">React, Vite, TypeScript, Express, Prisma, PostgreSQL(Supabase), Redis, Socket.IO, GCP(Cloud Run/GCE)</span>
    </p>
    <p>
      <span>친구들과 함께 운영 중인 리그 오브 레전드 사설 내전 커뮤니티를 위한 실제 프로덕션 서비스입니다. 내전 팀 구성을 위한 실시간 경매(드래프트), 배팅, 랭킹, 시즌 패스 등 커뮤니티 운영에 필요한 기능을 기획부터 운영까지 직접 맡고 있습니다.</span>
    </p>
    <p>
      <strong>운영 성과</strong> (2026. 05 ~ 07, 약 2개월 운영 기준)
      <br />
      <span class="muted">DAU 65명 · WAU 93명 · MAU 129명 · 고착도(DAU÷MAU) 약 50% · 누적 가입 134명 · 내전 참여 전환율(누적) 60.2% · 7일 코호트 활성화율 85.7%</span>
    </p>
    <ul>
      <li>DAU/WAU/MAU·리텐션 코호트·이탈률·참여 깊이·포인트 경제까지 추적하는 자체 프로덕트 대시보드를 설계·구축해 지표 기반 의사결정 체계 수립</li>
      <li>WebSocket + Redis 기반 실시간 경매(드래프트) 시스템 — API 서버와 WS 서버가 같은 상태를 나눠 갖는 구조에서 생긴 동시성 버그를 진단·수정</li>
      <li>단일 모임 전용이던 서비스를 여러 모임이 함께 쓸 수 있는 멀티테넌트 구조로 전환(앱 레벨 테넌트 격리, 모임별 기능 on/off 플러그인 시스템)</li>
      <li>운영 중 발생한 N+1 쿼리·커넥션 풀 고갈 등 실 서비스 성능 이슈를 <code>pg_stat_statements</code> 실측 기반으로 진단·해결</li>
      <li>배포 사고 대응 후 재발 방지 체계 수립(git=운영 원칙, 배포 커맨드 안전장치 등)</li>
    </ul>
    <p>
      <span>운영하며 겪은 사고와 설계 결정들은 <a href="/tags.html#운영일지">개발 일지 시리즈</a>에 기록하고 있습니다.</span>
    </p>
  </div>
  <aside class="toc">
    <p class="toc-title">목차</p>
    <nav>
      <ul>
        {toc.map((h) => (
          <li class={h.depth === 3 ? 'depth-3' : 'depth-2'}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
  </div>
</Base>

<style is:global>
  /* about의 hr은 섹션 구분선 — 제목에 붙여 쓰므로 본문 hr보다 여백을 좁힌다 */
  .about h2 { margin-bottom: 0.4rem; }
  .about hr { margin: 0 0 1.3rem; }
  .about hr + h3 { margin-top: 0; }
  .about h3 { margin-top: 1.9rem; }
  .about h4 { margin-top: 1.5rem; }
  .about .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.5rem 1.5rem;
  }
  .about .skills-grid p { margin: 0.4rem 0; }
  .stat-highlight { color: #0d9488; font-weight: 600; }
  html[data-theme='dark'] .stat-highlight { color: #2dd4bf; }
</style>

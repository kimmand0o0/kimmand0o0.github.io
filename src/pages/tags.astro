---
import Base from '../layouts/Base.astro';
import { allPosts, formatDate, postPath, tagsOf } from '../lib/posts';

const posts = await allPosts();
const byTag = new Map<string, typeof posts>();
for (const post of posts) {
  for (const tag of tagsOf(post)) {
    if (!byTag.has(tag)) byTag.set(tag, []);
    byTag.get(tag)!.push(post);
  }
}

// 글 수 많은 순으로 배치 — 중심에 큰 태그가 오도록
const entries = [...byTag.entries()].sort((a, b) => b[1].length - a[1].length);
const maxCount = Math.max(...entries.map(([, list]) => list.length));
const minCount = Math.min(...entries.map(([, list]) => list.length));

// 황금각(137.5°) 나선 배치 — 난수 없이 결정적이면서 겹치지 않고 흩어진다
// 배치는 여기서 씨앗만 잡고, 실제 겹침 해소는 클라이언트에서 측정 후 처리한다
// (글자 폭은 폰트가 로드돼야 알 수 있어서 빌드 시점에는 계산할 수 없다)
const GOLDEN_ANGLE = Math.PI * (3 - Math.sqrt(5));
const scatter = entries.map(([tag, list], i) => {
  const radius = Math.sqrt(i / entries.length) * 47; // % 단위, 중심에서의 거리
  const angle = i * GOLDEN_ANGLE;
  const t = maxCount === minCount ? 1 : (list.length - minCount) / (maxCount - minCount);
  return {
    tag,
    count: list.length,
    left: 50 + radius * Math.cos(angle) * 1.22,
    top: 50 + radius * Math.sin(angle),
    size: 0.8 + t * 1.1, // rem
    weight: t > 0.55 ? 700 : t > 0.25 ? 600 : 500,
    tone: t, // 글 수에 따른 농담 — 큰 태그일수록 진하게
    // 태그마다 다른 주기로 떠다니게 (난수 없이 인덱스에서 파생)
    dur: 6 + ((i * 7) % 5),
    delay: -((i * 13) % 60) / 10,
  };
});

const tagData = Object.fromEntries(
  entries.map(([tag, list]) => [
    tag,
    list.map((p) => ({ title: p.data.title, url: postPath(p), date: formatDate(p) })),
  ])
);
---

<Base title="Tags" width="wide">
  <h1 class="page-title">Tags</h1>
  <p class="tags-hint muted">태그를 눌러 관련 글을 볼 수 있어요. 크기는 글 수에 비례해요.</p>

  <div class="tag-scatter" id="tag-scatter">
    {
      scatter.map((s) => (
        <button
          class="tag-dot"
          data-tag={s.tag}
          data-seed-left={s.left}
          data-seed-top={s.top}
          style={`left:${s.left}%; top:${s.top}%; font-size:${s.size}rem; font-weight:${s.weight}; --tone:${s.tone.toFixed(3)}; --dur:${s.dur}s; --delay:${s.delay}s;`}
        >
          <span class="tag-label">
            {s.tag}
            <span class="tag-count">{s.count}</span>
          </span>
        </button>
      ))
    }
  </div>

  <section id="tag-posts" class="tag-posts" hidden>
    <header class="tag-posts-head">
      <h2 id="tag-posts-title"></h2>
      <button type="button" id="tag-posts-close" aria-label="닫기">✕</button>
    </header>
    <ul class="archive-list" id="tag-posts-list"></ul>
  </section>

  <script type="application/json" id="tag-data" set:html={JSON.stringify(tagData)} />

  <script is:inline>
    // 겹침 해소 — 씨앗 좌표에서 시작해 서로 밀어내고 컨테이너 안으로 가둔다
    (function () {
      var box = document.getElementById('tag-scatter');
      var dots = Array.prototype.slice.call(box.querySelectorAll('.tag-dot'));
      if (!dots.length) return;

      function layout() {
        var W = box.clientWidth;
        var H = box.clientHeight;
        var PAD = 4; // 태그 사이 최소 여백(px) — 작을수록 빽빽하게

        var items = dots.map(function (el) {
          var w = el.offsetWidth;
          var h = el.offsetHeight;
          return {
            el: el,
            w: w,
            h: h,
            // 씨앗 좌표(%)를 픽셀 중심으로 변환
            x: (parseFloat(el.dataset.seedLeft) / 100) * W,
            y: (parseFloat(el.dataset.seedTop) / 100) * H,
          };
        });

        function clamp(it) {
          it.x = Math.min(Math.max(it.x, it.w / 2 + 2), W - it.w / 2 - 2);
          it.y = Math.min(Math.max(it.y, it.h / 2 + 2), H - it.h / 2 - 2);
        }
        items.forEach(clamp);

        for (var pass = 0; pass < 80; pass++) {
          var moved = false;
          for (var i = 0; i < items.length; i++) {
            for (var j = i + 1; j < items.length; j++) {
              var a = items[i];
              var b = items[j];
              var dx = b.x - a.x;
              var dy = b.y - a.y;
              var minX = (a.w + b.w) / 2 + PAD;
              var minY = (a.h + b.h) / 2 + PAD;
              var ox = minX - Math.abs(dx);
              var oy = minY - Math.abs(dy);
              if (ox <= 0 || oy <= 0) continue; // 안 겹침

              moved = true;
              // 덜 밀어내도 되는 축으로만 분리 — 배치가 덜 흐트러진다
              if (ox < oy) {
                var sx = (dx || 1) > 0 ? 1 : -1;
                a.x -= (sx * ox) / 2;
                b.x += (sx * ox) / 2;
              } else {
                var sy = (dy || 1) > 0 ? 1 : -1;
                a.y -= (sy * oy) / 2;
                b.y += (sy * oy) / 2;
              }
              clamp(a);
              clamp(b);
            }
          }
          if (!moved) break;
        }

        items.forEach(function (it, i) {
          it.el.style.left = it.x + 'px';
          it.el.style.top = it.y + 'px';
          // 중심에서 바깥으로 퍼지듯 등장
          if (!box.classList.contains('ready')) {
            it.el.style.setProperty('--enter-delay', (i * 12) + 'ms');
          }
        });
        box.classList.add('ready');
        bindRepel(items);
      }

      // 커서 주변의 태그들이 물결처럼 밀려난다 (커서가 올라간 태그 자신은 제자리에서 커진다)
      var boundItems = null;
      function bindRepel(items) {
        // layout()은 리사이즈마다 다시 도니, 리스너는 한 번만 건다
        boundItems = items;
        if (bindRepel.done) return;
        bindRepel.done = true;

        var REACH = 165; // 커서 영향 반경(px)
        var STRENGTH = 34; // 최대 밀림(px)
        var pending = false;
        var cursor = null;

        function apply() {
          pending = false;
          if (!cursor) return;
          var hovered = box.querySelector('.tag-dot:hover');
          boundItems.forEach(function (it) {
            // 커서가 올라간 태그는 확대 효과가 있으니 밀지 않는다
            if (it.el === hovered) {
              it.el.style.setProperty('--px', '0px');
              it.el.style.setProperty('--py', '0px');
              return;
            }
            var dx = it.x - cursor.x;
            var dy = it.y - cursor.y;
            var dist = Math.sqrt(dx * dx + dy * dy) || 1;
            if (dist > REACH) {
              it.el.style.setProperty('--px', '0px');
              it.el.style.setProperty('--py', '0px');
              return;
            }
            // 가까울수록 강하게, 멀수록 부드럽게 사그라든다
            var push = STRENGTH * Math.pow(1 - dist / REACH, 1.3);
            it.el.style.setProperty('--px', ((dx / dist) * push).toFixed(1) + 'px');
            it.el.style.setProperty('--py', ((dy / dist) * push).toFixed(1) + 'px');
          });
        }

        function release() {
          cursor = null;
          boundItems.forEach(function (it) {
            it.el.style.setProperty('--px', '0px');
            it.el.style.setProperty('--py', '0px');
          });
        }

        box.addEventListener('mousemove', function (e) {
          var r = box.getBoundingClientRect();
          cursor = { x: e.clientX - r.left, y: e.clientY - r.top };
          if (!pending) {
            pending = true;
            requestAnimationFrame(apply);
          }
        });
        box.addEventListener('mouseleave', release);

        // 키보드 이동 시에도 주변이 반응하도록
        dots.forEach(function (el) {
          el.addEventListener('focus', function () {
            for (var i = 0; i < boundItems.length; i++) {
              if (boundItems[i].el === el) {
                cursor = { x: boundItems[i].x, y: boundItems[i].y };
                apply();
                break;
              }
            }
          });
        });
        box.addEventListener('focusout', release);
      }

      // 폰트 로드 후 측정해야 폭이 정확하다
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(layout);
      } else {
        window.addEventListener('load', layout);
      }
      var t;
      window.addEventListener('resize', function () {
        clearTimeout(t);
        t = setTimeout(layout, 150);
      });
    })();

    (function () {
      var data = JSON.parse(document.getElementById('tag-data').textContent);
      var section = document.getElementById('tag-posts');
      var titleEl = document.getElementById('tag-posts-title');
      var listEl = document.getElementById('tag-posts-list');
      var buttons = document.querySelectorAll('.tag-dot');

      function select(tag, scroll) {
        var posts = data[tag];
        if (!posts) return;
        buttons.forEach(function (b) {
          b.classList.toggle('selected', b.dataset.tag === tag);
        });
        titleEl.innerHTML =
          '<span class="tag-posts-chip">#' + tag.replace(/</g, '&lt;') + '</span>' +
          '<span class="tag-posts-count">글 ' + posts.length + '개</span>';
        listEl.innerHTML = posts
          .map(function (p) {
            return (
              '<li><time>' + p.date + '</time><a href="' + p.url + '">' +
              p.title.replace(/</g, '&lt;') + '</a></li>'
            );
          })
          .join('');
        section.hidden = false;
        if (scroll) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#' + tag);
      }

      buttons.forEach(function (b) {
        b.addEventListener('click', function () { select(b.dataset.tag, true); });
      });

      document.getElementById('tag-posts-close').addEventListener('click', function () {
        section.hidden = true;
        buttons.forEach(function (b) { b.classList.remove('selected'); });
        history.replaceState(null, '', location.pathname);
      });

      // 기존 /tags.html#태그명 링크 호환 — 해시가 있으면 그 태그를 바로 연다
      var hash = decodeURIComponent(location.hash.slice(1));
      if (hash && data[hash]) select(hash, true);
    })();
  </script>
</Base>

<style is:global>
  .tags-hint { margin: -1rem 0 1.5rem; font-size: 0.86rem; }

  .tag-scatter {
    position: relative;
    width: 100%;
    height: 36rem;
    margin: 0 0 1rem;
    /* 배치가 끝나기 전 겹친 상태가 보이지 않게 */
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tag-scatter.ready { opacity: 1; }
  .tag-dot {
    position: absolute;
    /* --px/--py 는 이웃이 밀려나는 변위 (JS가 hover 때 계산) */
    transform: translate(-50%, -50%) translate(var(--px, 0px), var(--py, 0px));
    border: none;
    background: none;
    padding: 0.18em 0.5em;
    cursor: pointer;
    /* 글 수가 많을수록 진하게 — 자연스러운 원근감 */
    color: var(--fg);
    opacity: calc(0.42 + var(--tone, 0.5) * 0.58);
    font-family: inherit;
    line-height: 1.2;
    white-space: nowrap;
    border-radius: 999px;
    transition:
      color 0.2s ease,
      opacity 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* 부유 애니메이션은 안쪽 span 에만 — 바깥 transform(위치/밀림)과 충돌하지 않게 */
  .tag-label {
    display: inline-block;
    animation:
      tag-enter 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--enter-delay, 0ms) backwards,
      tag-float var(--dur, 7s) ease-in-out var(--delay, 0s) infinite;
  }
  @keyframes tag-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  @keyframes tag-enter {
    from { opacity: 0; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tag-label { animation: none; }
  }

  .tag-dot .tag-count {
    font-size: 0.6em;
    margin-left: 0.32em;
    vertical-align: super;
    font-weight: 500;
    opacity: 0.5;
  }

  .tag-dot:hover,
  .tag-dot:focus-visible,
  .tag-dot.selected {
    color: var(--accent);
    opacity: 1;
    background: var(--accent-soft);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .tag-dot:hover,
  .tag-dot:focus-visible {
    transform: translate(-50%, -50%) translate(var(--px, 0px), var(--py, 0px)) scale(1.4);
    z-index: 5;
  }
  /* 커진 상태에서 위아래로 흔들리면 산만해진다 */
  .tag-dot:hover .tag-label,
  .tag-dot:focus-visible .tag-label {
    animation-play-state: paused;
  }
  .tag-dot:hover .tag-count,
  .tag-dot.selected .tag-count { opacity: 0.75; }
  /* sticky 헤더에 제목이 가리지 않도록 */
  .tag-posts {
    margin-top: 1rem;
    scroll-margin-top: 5rem;
    padding: 1.4rem 1.6rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 3%, var(--bg));
    animation: panel-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .tag-posts-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .tag-posts-head h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    font-size: 1rem;
  }
  .tag-posts-chip {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .tag-posts-count { font-size: 0.82rem; font-weight: 500; color: var(--faint); }
  #tag-posts-close {
    border: none;
    background: none;
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
    padding: 0.35rem;
    border-radius: 6px;
    color: var(--faint);
    transition: color 0.15s ease, background 0.15s ease;
  }
  #tag-posts-close:hover { color: var(--accent); background: var(--accent-soft); }
  .tag-posts .archive-list li { margin: 0.5rem 0; }

  @media (max-width: 760px) {
    .tag-scatter { height: 42rem; }
  }
</style>

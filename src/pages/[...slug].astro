---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostListPage from '../components/PostListPage.astro';
import {
  allPosts,
  formatDate,
  postPath,
  categoriesOf,
  tagsOf,
  readingLabel,
  readingTip,
  excerptOf,
  postDate,
  seriesNavFor,
  PER_PAGE,
  type Post,
} from '../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  const totalPages = Math.ceil(posts.length / PER_PAGE);

  // 1) 포스트: Jekyll URL(/카테고리들/yyyy/mm/dd/slug.html) 그대로
  const paths: {
    params: { slug: string };
    props: {
      kind: 'post' | 'list';
      post?: Post;
      page?: number;
      posts?: Post[];
      totalPages?: number;
      series?: ReturnType<typeof seriesNavFor>;
    };
  }[] = posts.map((post) => ({
    params: { slug: postPath(post).slice(1).replace(/\.html$/, '') },
    props: { kind: 'post', post, series: seriesNavFor(post, posts) },
  }));

  // 2) 페이지네이션: /pageN/index.html (기존 URL 패턴 유지)
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { slug: `page${n}/index` },
      props: {
        kind: 'list',
        page: n,
        posts: posts.slice((n - 1) * PER_PAGE, n * PER_PAGE),
        totalPages,
      },
    });
  }
  return paths;
}

const { kind, post, page, posts, totalPages, series } = Astro.props;
let Content = null;
let toc: { depth: number; slug: string; text: string }[] = [];
if (kind === 'post' && post) {
  const rendered = await render(post);
  Content = rendered.Content;
  toc = rendered.headings.filter((h) => h.depth === 2 || h.depth === 3);
}
---

{
  kind === 'post' && post ? (
    <Base
      title={post.data.title}
      description={excerptOf(post, 155)}
      width="wide"
      article={{
        published: postDate(post).toISOString(),
        tags: tagsOf(post),
      }}
    >
      <div class="post-layout">
      <article class="post">
        <header>
          <h1 class="post-title">{post.data.title}</h1>
          <div class="post-meta">
            <time>{formatDate(post)}</time>
            <span class="chip">{categoriesOf(post).at(-1)}</span>
            <span class="reading tip" data-tip={readingTip(post)}>{readingLabel(post)}</span>
            <span class="views" data-views-path={postPath(post)} hidden />
            <span class="comments-metric" data-comments-path={postPath(post)} hidden />
              <span class="likes-metric" data-likes-path={postPath(post)} hidden />
            {tagsOf(post).length > 0 && (
              <span class="tags">
                {tagsOf(post).map((t) => (
                  <a href={`/tags.html#${t}`}>#{t}</a>
                ))}
              </span>
            )}
          </div>
        </header>
        <div class="prose">
          <Content />
        </div>

        <div class="like-box">
          <button
            type="button"
            id="like-btn"
            class="tip"
            data-tip="이 게시글이 마음에 든다면 따봉을 눌러주세요!"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
            <span id="like-count">0</span>
          </button>
        </div>

        {series && (
          <nav class="series-nav" aria-label="시리즈 이동">
            <p class="series-head">
              <span class="series-name">{series.name}</span>
              <span class="series-pos">{series.total}편 중 {series.index}번째</span>
            </p>
            <div class="series-links">
              {series.prev ? (
                <a class="series-prev" href={series.prev.url}>
                  <span class="series-dir">← 이전 편</span>
                  <span class="series-title">{series.prev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {series.next && (
                <a class="series-next" href={series.next.url}>
                  <span class="series-dir">다음 편 →</span>
                  <span class="series-title">{series.next.title}</span>
                </a>
              )}
            </div>
          </nav>
        )}

        {/* 댓글 — 외부 서비스 없이 자체 워커(D1)에 저장한다 */}
        <section class="post-comments">
          <h2 class="comments-title">댓글 <span id="comments-count" class="comments-count"></span></h2>
          <ul class="comment-list" id="comment-list"></ul>
          <p class="comment-empty" id="comment-empty" hidden>아직 댓글이 없어요. 첫 댓글을 남겨보세요.</p>

          <p class="reply-to" id="reply-to" hidden>
            <span id="reply-to-label"></span>
            <button type="button" id="reply-cancel">취소</button>
          </p>
          <form class="comment-form" id="comment-form">
            <input
              type="text"
              id="comment-author"
              name="author"
              placeholder="이름"
              maxlength="30"
              required
            />
            <textarea
              id="comment-body"
              name="body"
              placeholder="댓글을 남겨주세요"
              maxlength="1000"
              rows="3"
              required></textarea>
            {/* 사람에게는 보이지 않는 미끼 입력 — 봇이 채우면 저장하지 않는다 */}
            <input type="text" name="website" id="comment-website" tabindex="-1" autocomplete="off" />
            <div class="comment-form-foot">
              <span class="comment-status" id="comment-status"></span>
              <button type="submit" id="comment-submit">등록</button>
            </div>
          </form>
        </section>
      </article>
      <script
        is:inline
        define:vars={{ viewPath: postPath(post), chatOrigin: 'https://kimmand0o0-blog-chat.kimmand0o0.workers.dev' }}
      >
        // 조회수 기록 — 같은 탭에서 새로고침해도 세션당 글 1회만 센다.
        // (sessionStorage 는 탭을 닫으면 비므로, 나중에 다시 오면 새 방문으로 잡힌다)
        (() => {
          const key = 'viewed:' + viewPath;
          try {
            if (sessionStorage.getItem(key)) return;
            sessionStorage.setItem(key, '1');
          } catch (e) {
            // 프라이빗 모드 등으로 storage 가 막히면 중복 제거 없이 그냥 기록한다
          }
          fetch(chatOrigin + '/api/view', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: viewPath }),
            keepalive: true,
          }).catch(() => {});
        })();
      </script>

      <script
        is:inline
        define:vars={{ likePath: postPath(post), likeApi: 'https://kimmand0o0-blog-chat.kimmand0o0.workers.dev' }}
      >
        {
          const btn = document.getElementById('like-btn');
          const countEl = document.getElementById('like-count');
          const key = 'liked:' + likePath;
          // "이미 눌렀는지"는 브라우저가 기억한다 — 로그인이 없으니 여기까지가 최선
          const likedNow = () => {
            try { return localStorage.getItem(key) === '1'; } catch { return false; }
          };
          const paint = (n) => {
            countEl.textContent = n;
            const on = likedNow();
            btn.classList.toggle('liked', on);
            btn.setAttribute('aria-pressed', String(on));
            btn.dataset.tip = on
              ? '추천을 취소하려면 다시 눌러주세요'
              : '이 게시글이 마음에 든다면 따봉을 눌러주세요!';
          };

          fetch(`${likeApi}/api/likes/top?limit=1000`)
            .then((r) => (r.ok ? r.json() : null))
            .then((json) => {
              const hit = (json?.items ?? []).find((i) => i.path === likePath);
              paint(hit ? hit.likes : 0);
            })
            .catch(() => paint(0));

          btn.addEventListener('click', async () => {
            const on = likedNow();
            btn.disabled = true;
            try {
              const res = await fetch(`${likeApi}/api/like`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: likePath, action: on ? 'remove' : 'add' }),
              });
              if (res.ok) {
                const { likes } = await res.json();
                try { on ? localStorage.removeItem(key) : localStorage.setItem(key, '1'); } catch {}
                paint(likes);
              }
            } catch {
              /* 추천 실패는 조용히 넘긴다 — 글 읽기에 영향 없음 */
            } finally {
              btn.disabled = false;
            }
          });
        }
      </script>

      <script
        is:inline
        define:vars={{ commentPath: postPath(post), api: 'https://kimmand0o0-blog-chat.kimmand0o0.workers.dev' }}
      >
        {
          const list = document.getElementById('comment-list');
          const empty = document.getElementById('comment-empty');
          const countEl = document.getElementById('comments-count');
          const form = document.getElementById('comment-form');
          const status = document.getElementById('comment-status');
          const submit = document.getElementById('comment-submit');

          const fmt = (iso) => {
            const d = new Date(iso);
            const p = (n) => String(n).padStart(2, '0');
            return `${d.getFullYear()}.${p(d.getMonth() + 1)}.${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
          };

          let replyTo = null;
          const replyBar = document.getElementById('reply-to');
          const replyLabel = document.getElementById('reply-to-label');

          const setReplyTo = (c) => {
            replyTo = c;
            replyBar.hidden = !c;
            if (c) {
              replyLabel.textContent = `${c.author}님에게 답글`;
              document.getElementById('comment-body').focus();
            }
          };
          document.getElementById('reply-cancel').addEventListener('click', () => setReplyTo(null));

          // textContent 로만 넣는다 — 사용자 입력을 HTML 로 해석하지 않기 위해
          const nodeFor = (c) => {
            const li = document.createElement('li');
            if (c.is_bot) li.classList.add('is-bot');
            if (c.parent_id) li.classList.add('is-reply');

            const head = document.createElement('div');
            head.className = 'comment-head';
            const who = document.createElement('span');
            who.className = 'comment-author';
            who.textContent = c.author;
            if (c.is_bot) {
              const badge = document.createElement('span');
              badge.className = 'bot-badge';
              badge.textContent = 'AI';
              who.appendChild(badge);
            }
            const when = document.createElement('time');
            when.textContent = fmt(c.created_at);
            head.append(who, when);

            const body = document.createElement('p');
            body.className = 'comment-body';
            body.textContent = c.body;

            const reply = document.createElement('button');
            reply.type = 'button';
            reply.className = 'reply-btn';
            reply.textContent = '답글';
            reply.addEventListener('click', () => setReplyTo(c));

            li.append(head, body, reply);
            return li;
          };

          const render = (items) => {
            list.textContent = '';
            const children = new Map();
            for (const c of items) {
              if (!c.parent_id) continue;
              if (!children.has(c.parent_id)) children.set(c.parent_id, []);
              children.get(c.parent_id).push(c);
            }
            for (const c of items) {
              if (c.parent_id) continue; // 답글은 부모 아래에서 그린다
              const li = nodeFor(c);
              const kids = children.get(c.id);
              if (kids?.length) {
                const sub = document.createElement('ul');
                sub.className = 'comment-replies';
                kids.forEach((k) => sub.appendChild(nodeFor(k)));
                li.appendChild(sub);
              }
              list.appendChild(li);
            }
            countEl.textContent = items.length ? items.length : '';
            empty.hidden = items.length > 0;
          };

          const load = () =>
            fetch(`${api}/api/comments?path=${encodeURIComponent(commentPath)}`)
              .then((r) => (r.ok ? r.json() : null))
              .then((json) => render(json?.items ?? []))
              .catch(() => {
                empty.textContent = '댓글을 불러오지 못했어요.';
                empty.hidden = false;
              });

          load();

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const author = document.getElementById('comment-author').value.trim();
            const body = document.getElementById('comment-body').value.trim();
            if (!author || !body) return;

            submit.disabled = true;
            status.textContent = '등록 중…';
            try {
              const res = await fetch(`${api}/api/comments`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  path: commentPath,
                  author,
                  body,
                  parentId: replyTo ? replyTo.id : undefined,
                  website: document.getElementById('comment-website').value,
                }),
              });
              if (res.status === 429) {
                status.textContent = '조금 뒤에 다시 시도해주세요.';
              } else if (!res.ok) {
                status.textContent = '등록에 실패했어요.';
              } else {
                document.getElementById('comment-body').value = '';
                setReplyTo(null);
                status.textContent = '만두봇이 읽는 중…';
                await load();
                // 봇 답글은 뒤에서 생성되므로 잠시 뒤 한 번 더 가져온다
                setTimeout(async () => {
                  await load();
                  status.textContent = '';
                }, 6000);
              }
            } catch {
              status.textContent = '등록에 실패했어요.';
            } finally {
              submit.disabled = false;
            }
          });
        }
      </script>
      {toc.length > 1 && (
        <aside class="toc">
          <p class="toc-title">목차</p>
          <nav>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'depth-3' : 'depth-2'}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
      </div>
    </Base>
  ) : (
    <Base title={`글 목록 ${page}페이지`}>
      <PostListPage posts={posts!} page={page!} totalPages={totalPages!} />
    </Base>
  )
}

---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostListPage from '../components/PostListPage.astro';
import {
  allPosts,
  formatDate,
  postPath,
  categoriesOf,
  tagsOf,
  readingLabel,
  readingTip,
  PER_PAGE,
  type Post,
} from '../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  const totalPages = Math.ceil(posts.length / PER_PAGE);

  // 1) 포스트: Jekyll URL(/카테고리들/yyyy/mm/dd/slug.html) 그대로
  const paths: {
    params: { slug: string };
    props: { kind: 'post' | 'list'; post?: Post; page?: number; posts?: Post[]; totalPages?: number };
  }[] = posts.map((post) => ({
    params: { slug: postPath(post).slice(1).replace(/\.html$/, '') },
    props: { kind: 'post', post },
  }));

  // 2) 페이지네이션: /pageN/index.html (기존 URL 패턴 유지)
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { slug: `page${n}/index` },
      props: {
        kind: 'list',
        page: n,
        posts: posts.slice((n - 1) * PER_PAGE, n * PER_PAGE),
        totalPages,
      },
    });
  }
  return paths;
}

const { kind, post, page, posts, totalPages } = Astro.props;
let Content = null;
let toc: { depth: number; slug: string; text: string }[] = [];
if (kind === 'post' && post) {
  const rendered = await render(post);
  Content = rendered.Content;
  toc = rendered.headings.filter((h) => h.depth === 2 || h.depth === 3);
}
---

{
  kind === 'post' && post ? (
    <Base title={post.data.title} width="wide">
      <div class="post-layout">
      <article class="post">
        <header>
          <h1 class="post-title">{post.data.title}</h1>
          <div class="post-meta">
            <time>{formatDate(post)}</time>
            <span class="chip">{categoriesOf(post).at(-1)}</span>
            <span class="reading tip" data-tip={readingTip(post)}>{readingLabel(post)}</span>
            <span class="views" data-views-path={postPath(post)} hidden />
            {tagsOf(post).length > 0 && (
              <span class="tags">
                {tagsOf(post).map((t) => (
                  <a href={`/tags.html#${t}`}>#{t}</a>
                ))}
              </span>
            )}
          </div>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
      <script
        is:inline
        define:vars={{ viewPath: postPath(post), chatOrigin: 'https://kimmand0o0-blog-chat.kimmand0o0.workers.dev' }}
      >
        // 조회수 기록 — 같은 탭에서 새로고침해도 세션당 글 1회만 센다.
        // (sessionStorage 는 탭을 닫으면 비므로, 나중에 다시 오면 새 방문으로 잡힌다)
        (function () {
          var key = 'viewed:' + viewPath;
          try {
            if (sessionStorage.getItem(key)) return;
            sessionStorage.setItem(key, '1');
          } catch (e) {
            // 프라이빗 모드 등으로 storage 가 막히면 중복 제거 없이 그냥 기록한다
          }
          fetch(chatOrigin + '/api/view', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: viewPath }),
            keepalive: true,
          }).catch(function () {});
        })();
      </script>
      {toc.length > 1 && (
        <aside class="toc">
          <p class="toc-title">목차</p>
          <nav>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'depth-3' : 'depth-2'}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
      </div>
    </Base>
  ) : (
    <Base title={`글 목록 ${page}페이지`}>
      <PostListPage posts={posts!} page={page!} totalPages={totalPages!} />
    </Base>
  )
}

---
import {
  formatDate,
  postPath,
  categoriesOf,
  excerptOf,
  readingLabel,
  readingTip,
  type Post,
} from '../lib/posts';

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
}
const { posts, page, totalPages } = Astro.props;
const newerHref = page === 2 ? '/' : `/page${page - 1}/`;
const olderHref = `/page${page + 1}/`;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a class="title" href={postPath(post)}>
          {post.data.title}
        </a>
        <p class="excerpt">{excerptOf(post, 150)}</p>
        <div class="meta">
          <time>{formatDate(post)}</time>
          <span class="chip">{categoriesOf(post).at(-1)}</span>
          <span class="reading tip" data-tip={readingTip(post)}>{readingLabel(post)}</span>
          <span class="views" data-views-path={postPath(post)} hidden />
        </div>
      </li>
    ))
  }
</ul>
<nav class="pagination">
  <span>{page > 1 ? <a href={newerHref}>← 최근 글</a> : null}</span>
  <span class="count">{page} / {totalPages}</span>
  <span>{page < totalPages ? <a href={olderHref}>지난 글 →</a> : null}</span>
</nav>
